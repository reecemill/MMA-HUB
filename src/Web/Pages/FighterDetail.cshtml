@page "{slug}"
@model Web.Pages.FighterDetailModel
@{
    ViewData["Title"] = Model.FighterData.Name;
    ViewData["HideBackground"] = true;
    var fighter = Model.FighterData;
    var bio = fighter.Bio;
    var career = Model.Career;
}

<a asp-page="/Fighters" class="back-link">&larr; Back to Fighters</a>

<div class="fighter-header">
    <h1>
        @if (Model.Rank is int rank && rank > 0)
        {
            <span class="rank-badge">#@rank</span>
        }
        @fighter.Name
    </h1>
    @if (Format.Nickname(fighter.NickName) is string nickname)
    {
        <p class="fighter-nickname">@nickname</p>
    }
    <p class="fighter-meta">
        @Format.Text(fighter.WeightClass)
        @if (Model.Rank == 0)
        {
            <span class="champion-badge">Champion</span>
        }
        &middot; @(bio?.Status ?? (Model.IsActive ? "Active" : "Inactive"))
    </p>
    <a asp-page="/DreamFight" asp-route-a="@fighter.Slug" class="btn btn-primary btn-sm">Dream fight with @fighter.Name</a>
</div>

<div class="fighter-bio-grid">
    <div class="bio-tile"><span class="bio-label">Pro record</span><span class="bio-value">@Format.Text(fighter.Record)</span></div>
    <div class="bio-tile"><span class="bio-label">Age</span><span class="bio-value">@(Model.Age?.ToString() ?? Format.Missing)</span></div>
    <div class="bio-tile"><span class="bio-label">Height</span><span class="bio-value">@Format.Height(fighter.HeightInches)</span></div>
    <div class="bio-tile"><span class="bio-label">Reach</span><span class="bio-value">@Format.Inches(fighter.ReachInches)</span></div>
    <div class="bio-tile"><span class="bio-label">Weight</span><span class="bio-value">@Format.Pounds(fighter.WeightLbs)</span></div>
    <div class="bio-tile"><span class="bio-label">Stance</span><span class="bio-value">@Format.Text(fighter.Stance)</span></div>
    <div class="bio-tile"><span class="bio-label">Born</span><span class="bio-value">@Format.Text(fighter.Born)</span></div>
    @if (bio?.TrainsAt != null)
    {
        <div class="bio-tile"><span class="bio-label">Trains at</span><span class="bio-value">@bio.TrainsAt</span></div>
    }
    @if (bio?.FightingStyle != null)
    {
        <div class="bio-tile"><span class="bio-label">Fighting Style</span><span class="bio-value">@bio.FightingStyle</span></div>
    }
    @if (bio?.OctagonDebut != null)
    {
        <div class="bio-tile"><span class="bio-label">Octagon Debut</span><span class="bio-value">@Format.Date(bio.OctagonDebut)</span></div>
    }
</div>

@if (Model.FightHistory.Count > 0)
{
    <h2 class="stats-section-title">UFC Fights</h2>
    <div class="table-card section-card">
        <table class="table">
            <thead>
                <tr><th>Result</th><th>Opponent</th><th>Method</th><th>Event</th><th>Date</th></tr>
            </thead>
            <tbody>
                @foreach (var fight in Model.FightHistory)
                {
                    var side = Model.Side(fight);
                    <tr>
                        <td><span class="result-text @side.Result.ToLower().Replace(" ", "-")">@side.Result</span></td>
                        <td>
                            @if (side.Opponent != null)
                            {
                                <a asp-page="/FighterDetail" asp-route-slug="@side.Opponent.Slug" class="fighter-link">@side.Opponent.Name</a>
                            }
                            else
                            {
                                <text>TBD</text>
                            }
                        </td>
                        <td>
                            @if (fight.IsFinished)
                            {
                                <a asp-page="/FightDetail" asp-route-id="@fight.Id" class="fighter-link">@fight.Result</a>
                            }
                            else
                            {
                                @Format.Missing
                            }
                        </td>
                        <td><a asp-page="/EventDetail" asp-route-id="@fight.EventId" class="fighter-link">@fight.Event?.Name</a></td>
                        <td class="nowrap">@Format.Date(fight.Event?.Date)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.WinMethodChartCss != null)
{
    <div class="charts-row">
        <div class="chart-card">
            <h5>UFC Wins by Method</h5>
            <div class="donut" style="background: conic-gradient(@Html.Raw(Model.WinMethodChartCss))"></div>
            <ul class="chart-legend">
                @foreach (var item in Model.WinMethodLegend)
                {
                    <li><span class="legend-dot" style="background: @item.Color"></span>@item.Label: @item.Value</li>
                }
            </ul>
        </div>
    </div>
}

@if (Model.SummaryStats.Count > 0 || career != null)
{
    <h2 class="stats-section-title">UFC Stats</h2>
}

@if (Model.SummaryStats.Count > 0)
{
    <div class="summary-banner">
        @foreach (var stat in Model.SummaryStats)
        {
            <div class="summary-stat">
                <span class="count">@stat.Value</span>
                <span class="label">@stat.Label</span>
            </div>
        }
    </div>
}

@if (career != null)
{
    <div class="charts-row">
        <div class="chart-card accuracy-card">
            <div class="radial-progress" style="background: conic-gradient(@Html.Raw(Model.StrikingAccuracyGradient))">
                <span class="radial-progress-value">@Format.Percent(career.StrikingAccuracy)</span>
            </div>
            <div>
                <h5>Striking Accuracy</h5>
                <ul class="accuracy-card-stats">
                    <li>Sig. Strikes Landed: @career.SigLanded</li>
                    <li>Sig. Strikes Attempted: @career.SigAttempted</li>
                </ul>
            </div>
        </div>

        <div class="chart-card accuracy-card">
            <div class="radial-progress" style="background: conic-gradient(@Html.Raw(Model.TakedownAccuracyGradient))">
                <span class="radial-progress-value">@Format.Percent(career.TakedownAccuracy)</span>
            </div>
            <div>
                <h5>Takedown Accuracy</h5>
                <ul class="accuracy-card-stats">
                    <li>Takedowns Landed: @career.TakedownsLanded</li>
                    <li>Takedowns Attempted: @career.TakedownsAttempted</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="charts-row">
        <div class="chart-card performance-card">
            <h5>Offensive Stats</h5>
            <div class="metric-grid">
                <div class="metric"><span class="count">@career.SigLandedPerMinute.ToString("0.00")</span><span class="label">Sig Str Landed/Min</span></div>
                <div class="metric"><span class="count">@career.TakedownsPer15.ToString("0.00")</span><span class="label">Takedowns/15 Min</span></div>
                <div class="metric"><span class="count">@career.SubmissionsPer15.ToString("0.00")</span><span class="label">Sub Attempts/15 Min</span></div>
                <div class="metric"><span class="count">@career.KnockdownsPer15.ToString("0.00")</span><span class="label">Knockdowns/15 Min</span></div>
            </div>
        </div>

        <div class="chart-card performance-card">
            <h5>Defensive Stats</h5>
            <div class="metric-grid">
                <div class="metric"><span class="count">@career.SigAbsorbedPerMinute.ToString("0.00")</span><span class="label">Sig Str Absorbed/Min</span></div>
                <div class="metric"><span class="count">@Format.Percent(career.StrikingDefense)</span><span class="label">Sig Str Defense</span></div>
                <div class="metric"><span class="count">@Format.Percent(career.TakedownDefense)</span><span class="label">Takedown Defense</span></div>
                <div class="metric"><span class="count">@Format.Clock(career.AverageFightSeconds)</span><span class="label">Avg Fight Time</span></div>
            </div>
        </div>
    </div>

    <div class="charts-row">
        <div class="table-card stat-bars">
            <h5>Sig. Strikes by Position</h5>
            @foreach (var item in Model.StrikePositionBreakdown)
            {
                <div class="stat-bar-row">
                    <span class="stat-bar-label">@item.Label</span>
                    <div class="stat-bar-track">
                        <div class="stat-bar-fill" style="width: @((item.Percent * 100).ToString("0.##"))%"></div>
                    </div>
                    <span class="stat-bar-value">@Format.Percent(item.Percent)</span>
                </div>
            }
        </div>

        <div class="table-card stat-bars">
            <h5>Sig. Strikes by Target</h5>
            @foreach (var item in Model.StrikeTargetBreakdown)
            {
                <div class="stat-bar-row">
                    <span class="stat-bar-label">@item.Label</span>
                    <div class="stat-bar-track">
                        <div class="stat-bar-fill" style="width: @((item.Percent * 100).ToString("0.##"))%"></div>
                    </div>
                    <span class="stat-bar-value">@Format.Percent(item.Percent)</span>
                </div>
            }
        </div>
    </div>
    <p class="reasons-note">Over @career.Fights UFC fight@(career.Fights == 1 ? "" : "s") with stats (@Format.Clock(career.Seconds) of fight time).</p>
}
