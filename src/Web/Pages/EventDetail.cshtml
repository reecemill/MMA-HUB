@page "{slug}"
@model Web.Pages.EventDetailModel
@inject Web.Services.FightPredictor Predictor
@{
    ViewData["Title"] = Model.EventData.Title ?? "Event";
    ViewData["HideBackground"] = true;
}

<a asp-page="/Events" class="back-link">&larr; Back to Events</a>

<div class="fighter-header">
    <h1>@Model.EventData.Title</h1>
    <p class="fighter-meta">
        @(Model.EventData.EventDate?.ToString("MMM dd, yyyy") ?? Model.EventData.EventDateLabel ?? "-")
        @if (!string.IsNullOrWhiteSpace(Model.EventData.Venue))
        {
            <text>&middot; @Model.EventData.Venue</text>
        }
        @if (!string.IsNullOrWhiteSpace(Model.EventData.LocationText ?? Model.EventData.City))
        {
            <text>&middot; @(Model.EventData.LocationText ?? Model.EventData.City)</text>
        }
    </p>
    @if (Model.EventData.Status == "scheduled" && Model.EventData.EventDate < DateTime.UtcNow.Date)
    {
        <p class="prediction-note">
            This card was still upcoming when the data was collected (@Predictor.SnapshotDate.ToString("MMM d, yyyy")),
            so its results aren't included. The picks below were made from what was known then.
        </p>
    }
</div>

@if (Model.BoutsBySection.Count == 0)
{
    <p class="fighter-meta">No fight card data available for this event yet.</p>
}
else if (Model.ShowsPastPicks)
{
    <p class="prediction-note">
        <strong>Model's pick</strong> is what the prediction model said before each fight, from a
        version trained only on fights before 2024, so it never saw these results.
        <a asp-page="/HowItWorks">How the predictions work</a>
    </p>
}
else if (Model.Predictions.Count > 0)
{
    <p class="prediction-note">
        <strong>Model's pick</strong> is the favorite and their chance of winning, from each
        fighter's UFC record so far. <a asp-page="/HowItWorks">How the predictions work</a>
    </p>
}

@foreach (var cardSection in Model.BoutsBySection)
{
    <h2 class="stats-section-title">@cardSection.Key</h2>
    <div class="table-card section-card">
        <table class="table">
            <thead>
                <tr>
                    <th>Weight Class</th>
                    <th>Matchup</th>
                    <th>Result</th>
                    @if (Model.Predictions.Count > 0)
                    {
                        <th>Model's pick</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var bout in cardSection)
                {
                    <tr>
                        <td>
                            @bout.WeightClass
                            @if (bout.TitleBout)
                            {
                                <span class="champion-badge">Title</span>
                            }
                        </td>
                        <td>
                            <a asp-page="/BoutDetail" asp-route-id="@bout.Id" asp-route-eventSlug="@Model.EventData.Slug" class="fighter-link">
                                <span class="@(bout.Fighter1Outcome == "win" ? "bout-winner" : "")">@(bout.Fighter1Name ?? bout.Fighter1?.Name ?? "TBD")</span>
                                vs
                                <span class="@(bout.Fighter2Outcome == "win" ? "bout-winner" : "")">@(bout.Fighter2Name ?? bout.Fighter2?.Name ?? "TBD")</span>
                            </a>
                        </td>
                        <td>
                            @if (bout.IsCancelled)
                            {
                                <text>Cancelled</text>
                            }
                            else if (bout.Status == "completed")
                            {
                                @bout.Method @(bout.ResultRound != null ? $"(R{bout.ResultRound})" : "")
                            }
                            else
                            {
                                <text>Upcoming</text>
                            }
                        </td>
                        @if (Model.Predictions.Count > 0)
                        {
                            var pick = Model.Pick(bout);
                            <td class="pick-cell">
                                @if (pick != null)
                                {
                                    <span>@pick.Value.Favorite</span>
                                    <span class="pick-percent">@pick.Value.Percent%</span>
                                    @if (pick.Value.Correct == true)
                                    {
                                        <span class="pick-result correct" title="The favorite won">&#10003;</span>
                                    }
                                    else if (pick.Value.Correct == false)
                                    {
                                        <span class="pick-result wrong" title="The favorite lost">&#10007;</span>
                                    }
                                }
                                else
                                {
                                    <span class="pick-percent">&ndash;</span>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
