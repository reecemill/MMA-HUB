@inject Web.Services.FightPredictor Predictor
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — MMA Stats</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Web.styles.css" asp-append-version="true" />
</head>
<body class="@(ViewData["HideBackground"] is true ? "flat-bg" : "")">
    @if (ViewData["HideBackground"] is not true)
    {
        <div class="arena" aria-hidden="true">
            <canvas id="arena-canvas"></canvas>
        </div>
        <script src="~/js/arena.js" asp-append-version="true"></script>
    }
    @if (ViewData["HideNav"] is not true)
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-dark">
                <div class="container">
                    <a class="navbar-brand fw-bold text-uppercase" style="letter-spacing:2px;" asp-area="" asp-page="/Index">MMA Stats</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Fighters">Fighters</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Events">Events</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/DreamFight">Dream Fight</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/HowItWorks">How It Works</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer">
        <div class="container text-center py-3">
            UFC data from <a href="https://citoapi.com" class="fighter-link">Cito API</a>, results through
            @Predictor.SnapshotDate.ToString("MMM d, yyyy"). The model's fight stats are from
            <a href="http://ufcstats.com" class="fighter-link">ufcstats.com</a>.
            Not affiliated with the UFC.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
